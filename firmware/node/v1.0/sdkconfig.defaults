# SAFE-NODE node v1.0 defaults. `idf.py build` generates sdkconfig from these.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS: 1 ms tick for the 100 ms sensor period and latency measurement
CONFIG_FREERTOS_HZ=1000

# Task watchdog: 3 s, panic-reset, only the health task is subscribed (FR-14).
# Idle tasks are not checked, so a low-priority logger burst (TC-6) is legal.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Brown-out detector on (FR-16 warns before it trips)
CONFIG_ESP_BROWNOUT_DET=y

# Console
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
